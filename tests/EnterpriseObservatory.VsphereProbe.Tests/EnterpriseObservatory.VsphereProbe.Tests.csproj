<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The tool's own project, not a copy of it: InventoryTiming.Summarize is
      internal, and InternalsVisibleTo (tools/EnterpriseObservatory.VsphereProbe/AssemblyInfo.cs)
      is what lets this test reach it. Program's top-level statements are
      simply never invoked from here.
    -->
    <ProjectReference Include="..\..\tools\EnterpriseObservatory.VsphereProbe\EnterpriseObservatory.VsphereProbe.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Application\EnterpriseObservatory.Application.csproj" />
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Domain\EnterpriseObservatory.Domain.csproj" />
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Collectors.Redfish\EnterpriseObservatory.Collectors.Redfish.csproj" />
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Collectors.Simplivity\EnterpriseObservatory.Collectors.Simplivity.csproj" />
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Collectors.Vsphere\EnterpriseObservatory.Collectors.Vsphere.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded iLO 5 and the fake that serves it, from the Redfish collector's tests. -->
    <Compile Include="..\EnterpriseObservatory.Collectors.Redfish.Tests\FakeIlo.cs" Link="SourceContract\FakeIlo.cs" />
    <None Include="..\EnterpriseObservatory.Collectors.Redfish.Tests\Fixtures\ilo5-live-masked\*.json" LinkBase="Fixtures\ilo5-live-masked" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

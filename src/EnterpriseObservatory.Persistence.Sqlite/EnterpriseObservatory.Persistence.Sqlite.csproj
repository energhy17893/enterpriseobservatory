<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    SQLite because ADR-0001 requires an MSI that installs without an appliance:
    a database that is a file needs no service, no port and no DBA. See
    ADR-0011.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />

    <!--
      Pinned above what Microsoft.Data.Sqlite asks for. Its transitive
      SQLitePCLRaw 2.1.11 carries GHSA-2m69-gcr7-jv3q, and NuGet's audit fails
      the build on it — which is the point of having the audit. Overridden here
      rather than suppressed, so the day Microsoft.Data.Sqlite catches up this
      line can simply be deleted.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnterpriseObservatory.Application\EnterpriseObservatory.Application.csproj" />
  </ItemGroup>

</Project>

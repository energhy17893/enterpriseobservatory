<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-EnterpriseObservatory.Host.AllInOne-da5971c9-2db4-4715-8ac6-940234ae6f8e</UserSecretsId>
  </PropertyGroup>

  <!--
    The single-process deployment: collection and the web interface in one
    service, because ADR-0001 requires an MSI that installs without an
    appliance. Splitting them later is a hosting change, not a rewrite — the
    API and the cycles both depend only on ports.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EnterpriseObservatory.Api\EnterpriseObservatory.Api.csproj" />
    <ProjectReference Include="..\EnterpriseObservatory.Collectors.Vsphere\EnterpriseObservatory.Collectors.Vsphere.csproj" />
    <ProjectReference Include="..\EnterpriseObservatory.Persistence.Postgres\EnterpriseObservatory.Persistence.Postgres.csproj" />
  </ItemGroup>

  <!--
    MailKit rather than the framework's own System.Net.Mail.SmtpClient
    (roadmap M5.4). The built-in client's SslMode support does not cover
    implicit TLS on connect (the historic port-465 case) — Microsoft's own
    docs point away from it for anything but the simplest STARTTLS use — and
    this product has to offer all three modes an estate's relay might expect.
    MIT-licensed, same family as MimeKit which it depends on.
  -->
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <!--
    The compliance catalogues, as Broadcom published them, with their VERSION
    and LICENSE beside each. Copied next to the binary rather than embedded, so
    an operator can see exactly which file the product judges against.
  -->
  <ItemGroup>
    <Content Include="..\..\catalogues\**\*" LinkBase="catalogues" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

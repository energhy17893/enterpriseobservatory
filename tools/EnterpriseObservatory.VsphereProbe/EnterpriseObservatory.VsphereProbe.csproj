<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Collectors.Vsphere\EnterpriseObservatory.Collectors.Vsphere.csproj" />

    <!--
      For reading a stored connection, so nobody retypes a vCenter password
      to diagnose one. Referencing the adapter rather than Npgsql directly
      keeps one definition of how a connection is stored and decrypted — a
      tool that read it its own way would drift from the service and then
      disagree with it about whether a credential works.
    -->
    <ProjectReference Include="..\..\src\EnterpriseObservatory.Persistence.Postgres\EnterpriseObservatory.Persistence.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Data protection from the shared framework rather than as a standalone
      package. The package pulls System.Security.Cryptography.Xml, which
      carries several advisories the audit fails the build on; the framework
      ships a serviced copy. The service gets it the same way — and a
      diagnostic tool that decrypts differently from the service it diagnoses
      would be answering a different question.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
